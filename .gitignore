# RTL_Temp is a local development-history repository.
# Track modules only after explicitly adding them to this allowlist.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/ASU_TOP/
!/ADC_TOP/

# Disposable verification and EDA outputs
**/.work/verification/sim/
**/.work/verification/waves/
**/.work/verification/history/
**/.work/verification/state/
**/.work/verification/vcs/results/
**/.work/verification/**/__pycache__/
**/.work/verification/**/*.pyc
**/.work/verification/.vmware_transport_*.log
**/*.vcd
**/*.fsdb
**/*.wlf
**/*.jou
**/*.pb
**/*.str
**/work/
**/csrc/
**/simv*
**/ucli.key

# Editor and operating-system metadata
**/.vscode/
**/.idea/
**/Thumbs.db
**/.DS_Store
