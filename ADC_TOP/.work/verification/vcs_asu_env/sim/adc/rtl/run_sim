#!/bin/bash
set -euo pipefail

PROJECTS_ROOT="${PROJECTS_ROOT:-/home/${USER}/Project}"
export RES_OPTIONS="${RES_OPTIONS:-timeout:1 attempts:1}"
export LOCALDOMAIN="${LOCALDOMAIN:-.}"

die() {
    echo "Error: $*" >&2
    exit 1
}

[[ $# -ge 3 ]] || die "usage: run_sim <project> <module> <pattern> [simv arguments...]"
PROJECT_NAME="$1"
MODULE_NAME="$2"
PATTERN_NAME="$3"
shift 3

SIMV_ARGS=()
FSDB_MODE="off"
SEED_MODE="default"
TIME_LIMIT="none"

for option in "$@"; do
    case "${option}" in
        -fsdb)
            FSDB_MODE="on"
            SIMV_ARGS+=(+DUMP_FSDB)
            ;;
        -seed)
            [[ "${SEED_MODE}" == "default" ]] || die "specify only one seed option"
            SEED_MODE="automatic"
            SIMV_ARGS+=(+ntb_random_seed_automatic)
            ;;
        -seed=*)
            [[ "${SEED_MODE}" == "default" ]] || die "specify only one seed option"
            seed_value="${option#-seed=}"
            [[ "${seed_value}" =~ ^[0-9]+$ ]] || die "fixed seed must be an unsigned integer: ${option}"
            SEED_MODE="${seed_value}"
            SIMV_ARGS+=("+ntb_random_seed=${seed_value}")
            ;;
        -time=*)
            [[ "${TIME_LIMIT}" == "none" ]] || die "specify -time only once"
            time_value="${option#-time=}"
            [[ "${time_value}" =~ ^[0-9]+$ ]] || die "-time must be an unsigned integer in ms: ${option}"
            TIME_LIMIT="${time_value}ms"
            SIMV_ARGS+=("+SIM_TIMEOUT_MS=${time_value}")
            ;;
        +*)
            SIMV_ARGS+=("${option}")
            ;;
        *)
            die "unknown simulation option: ${option}"
            ;;
    esac
done

RUN_DIR="$(pwd -P)"
MODULE_SIM_ROOT="${PROJECTS_ROOT}/${PROJECT_NAME}/sim/${MODULE_NAME}"
case "${RUN_DIR}" in
    "${MODULE_SIM_ROOT}"/*) ;;
    *) die "run from a pattern directory below ${MODULE_SIM_ROOT}: ${RUN_DIR}" ;;
esac
RUN_SUBDIR="${RUN_DIR#${MODULE_SIM_ROOT}/}"
[[ -n "${RUN_SUBDIR}" && "${RUN_SUBDIR}" != */* ]] || \
    die "run from one direct pattern directory below ${MODULE_SIM_ROOT}: ${RUN_DIR}"

source "${MODULE_SIM_ROOT}/vcs_env.sh"

PROJECT_ROOT="${PROJECTS_ROOT}/${PROJECT_NAME}"
PUB_ROOT="${PROJECTS_ROOT}/pub"
PAT_MODULE_ROOT="${PROJECT_ROOT}/pat/${MODULE_NAME}"
COMMON_DIR="${PAT_MODULE_ROOT}/common"
PATTERN_SOURCE_DIR="${PAT_MODULE_ROOT}/${PATTERN_NAME}"
CONFIG_FILE="${PAT_MODULE_ROOT}/file_list"
TOP_FILE="${COMMON_DIR}/sim_top.sv"

[[ -f "${TOP_FILE}" ]] || die "common sim_top not found: ${TOP_FILE}"
[[ -f "${PATTERN_SOURCE_DIR}/pattern.vh" ]] || die "pattern source not found: ${PATTERN_SOURCE_DIR}/pattern.vh"
[[ -f "${CONFIG_FILE}" ]] || die "file_list not found: ${CONFIG_FILE}"
command -v vcs >/dev/null 2>&1 || die "vcs not found after sourcing ${MODULE_SIM_ROOT}/vcs_env.sh"
command -v vlogan >/dev/null 2>&1 || die "vlogan not found after sourcing ${MODULE_SIM_ROOT}/vcs_env.sh"

resolve_ref() {
    case "$1" in
        project:*) printf '%s/%s\n' "${PROJECT_ROOT}" "${1#project:}" ;;
        pub:*)     printf '%s/%s\n' "${PUB_ROOT}" "${1#pub:}" ;;
        *) die "file_list entry must start with project: or pub:: $1" ;;
    esac
}

"${RUN_DIR}/run_clr" --all
mkdir -p log
printf 'WORK > DEFAULT\nDEFAULT : ./work\n' > synopsys_sim.setup

FILELIST="${RUN_DIR}/filelist.f"
: > "${FILELIST}"
printf '+incdir+%s\n' "${PATTERN_SOURCE_DIR}" >> "${FILELIST}"
printf '+incdir+%s\n' "${COMMON_DIR}" >> "${FILELIST}"

section=""
while IFS= read -r raw || [[ -n "${raw}" ]]; do
    line="$(printf '%s' "${raw}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/\r$//')"
    [[ -z "${line}" || "${line}" == \#* ]] && continue
    case "${line}" in
        include:) section="include"; continue ;;
        source:)  section="source"; continue ;;
    esac
    [[ -n "${section}" ]] || die "entry appears before a section in ${CONFIG_FILE}: ${line}"
    resolved="$(resolve_ref "${line}")"
    if [[ "${section}" == "include" ]]; then
        [[ -d "${resolved}" ]] || die "include directory not found: ${resolved}"
        printf '+incdir+%s\n' "${resolved}" >> "${FILELIST}"
    elif [[ -d "${resolved}" ]]; then
        while IFS= read -r source_file; do
            printf '%s\n' "${source_file}" >> "${FILELIST}"
        done < <(find "${resolved}" -type f \( -name '*.v' -o -name '*.sv' \) | sort)
    elif [[ -f "${resolved}" ]]; then
        case "${resolved}" in
            *.v|*.sv) printf '%s\n' "${resolved}" >> "${FILELIST}" ;;
            *) die "source file must end in .v or .sv: ${resolved}" ;;
        esac
    else
        die "source path not found: ${resolved}"
    fi
done < "${CONFIG_FILE}"

printf '%s\n' "${TOP_FILE}" >> "${FILELIST}"

echo "PROJECT=${PROJECT_NAME} MODULE=${MODULE_NAME} PATTERN=${PATTERN_NAME}"
echo "OPTIONS: FSDB=${FSDB_MODE} SEED=${SEED_MODE} TIME_LIMIT=${TIME_LIMIT}"
printf 'SIMV_ARGS:'
printf ' %s' "${SIMV_ARGS[@]}"
printf '\n'
echo "Compiling file list: ${FILELIST}"

timeout --signal=TERM --kill-after=5s "${VCS_TIMEOUT_SECONDS:-300}" \
vlogan -full64 -sverilog -kdb \
    -timescale=1ns/1ps \
    -f "${FILELIST}" \
    -l "${RUN_DIR}/log/vlogan.log"

timeout --signal=TERM --kill-after=5s "${VCS_TIMEOUT_SECONDS:-300}" \
vcs -full64 -debug_access+all -sverilog -kdb -lca \
    +vcsd \
    -timescale=1ns/1ps \
    -P "${VERDI_HOME}/share/PLI/VCS/LINUX64/novas.tab" \
       "${VERDI_HOME}/share/PLI/VCS/LINUX64/pli.a" \
    work.sim_top \
    -o simv \
    -l "${RUN_DIR}/log/vcs.log"

[[ -x "${RUN_DIR}/simv" ]] || die "simv was not generated"
"${RUN_DIR}/simv" "${SIMV_ARGS[@]}" -l "${RUN_DIR}/log/sim.log"
