#!/bin/bash
set -euo pipefail

PROJECT_NAME="Detector"
MODULE_NAME="adc"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# Uncomment the patterns that should run. They execute sequentially in this
# same directory, so the final enabled pattern owns the remaining wave files.
PAT_LIST=(
    "P001_adc_link"
)

RUN_OPTIONS=(
    -fsdb
    # -seed
    -time=20
)

for PATTERN_NAME in "${PAT_LIST[@]}"; do
    echo "************************************************************"
    echo "Running: ${PROJECT_NAME}/${MODULE_NAME}/${PATTERN_NAME}"
    echo "************************************************************"
    "${SCRIPT_DIR}/run_sim" \
        "${PROJECT_NAME}" "${MODULE_NAME}" "${PATTERN_NAME}" \
        "${RUN_OPTIONS[@]}" "$@"
done

