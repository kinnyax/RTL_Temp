#!/bin/bash
set -euo pipefail

RUN_DIR="$(pwd -P)"
MODULE_SIM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "${MODULE_SIM_ROOT}/vcs_env.sh"

if [[ $# -ge 1 ]]; then
    WAVE_FILE="$1"
elif [[ -f "${RUN_DIR}/sim.fsdb" ]]; then
    WAVE_FILE="${RUN_DIR}/sim.fsdb"
elif [[ -f "${RUN_DIR}/sim.vpd" ]]; then
    WAVE_FILE="${RUN_DIR}/sim.vpd"
else
    WAVE_FILE="${RUN_DIR}/sim.vcd"
fi

[[ -f "${WAVE_FILE}" ]] || { echo "Error: waveform not found: ${WAVE_FILE}" >&2; exit 1; }
command -v verdi >/dev/null 2>&1 || { echo "Error: verdi not found after sourcing ${MODULE_SIM_ROOT}/vcs_env.sh" >&2; exit 1; }
verdi_args=(-full64 -kdb -nologo -ssf "${WAVE_FILE}")
if [[ -n "${NOVAS_RC:-}" ]]; then
    verdi_args=(-full64 -kdb -rcFile "${NOVAS_RC}" -nologo -ssf "${WAVE_FILE}")
fi
exec verdi "${verdi_args[@]}"

